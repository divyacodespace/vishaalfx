# ============================================================================
# VishaalFX — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# ---- Database ---------------------------------------------------------
# Supabase Postgres connection string — Project Settings -> Database ->
# Connection string -> URI ("Direct connection", port 5432). Get [YOUR-PASSWORD]
# from that same page (it is NOT the anon/service_role API key — those are for
# Supabase's REST/Auth client libraries, which this app does not use; Prisma
# talks to Postgres directly).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.hnaulcnioqvbildxdwve.supabase.co:5432/postgres"

# ---- Session / JWT secrets ---------------------------------------------
# Generate strong random values, e.g. `openssl rand -hex 32`
STUDENT_SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_SESSION_SECRET="replace-with-a-different-long-random-secret"

# ---- Admin account -------------------------------------------------------
# Used by prisma/seed.ts to create the first admin login. Change the password
# immediately after first login in a real deployment. Do NOT hardcode
# credentials anywhere else in the codebase.
ADMIN_SEED_NAME="ADMIN_NAME_PLACEHOLDER"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"

# Verified admin mailbox that receives new-enrollment notifications (no PDF
# attachment is ever sent — notifications only link into the admin dashboard).
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# ---- File storage -----------------------------------------------------
# STORAGE_DRIVER = "local" (filesystem — dev only, does NOT work on serverless
# hosts like Vercel since the filesystem is ephemeral) or "s3" (required in
# production on Vercel/serverless — bucket must be private, not public-read).
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT="./private-storage"

# Required when STORAGE_DRIVER="s3". Works with AWS S3 directly (leave
# S3_ENDPOINT blank, S3_REGION = e.g. "ap-south-1") or any S3-compatible
# provider — Cloudflare R2, Backblaze B2, Supabase Storage, MinIO — by
# setting S3_ENDPOINT to that provider's endpoint URL.
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# ---- E-sign provider (optional) -------------------------------------------
# If a legally recognized digital signature is required (vs. the drawn
# signature captured in-app), integrate a compliant e-sign provider here.
ESIGN_PROVIDER=""
ESIGN_API_KEY=""
ESIGN_API_SECRET=""

# ---- Business / legal placeholders ----------------------------------------
# DO NOT invent values for these. Leave placeholders until real, reviewed
# information is provided by the business owner / legal counsel.
BUSINESS_LEGAL_NAME="[LEGAL ENTITY NAME NOT YET PROVIDED]"
BUSINESS_ADDRESS="[REGISTERED ADDRESS NOT YET PROVIDED]"
BUSINESS_SUPPORT_EMAIL="support@example.com"
BUSINESS_SUPPORT_PHONE="[PHONE NUMBER NOT YET PROVIDED]"
BUSINESS_JURISDICTION="[GOVERNING JURISDICTION NOT YET PROVIDED]"

# ---- App -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="VishaalFX"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
